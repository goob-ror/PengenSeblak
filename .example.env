# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── Client (Vite) ────────────────────────────────────────────────────────────
# URL where the Express server is reachable from the browser
VITE_API_URL=http://localhost:3001

# ─── MySQL ────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pengen_seblak

# ─── Redis ────────────────────────────────────────────────────────────────────
# Optional — if not set, in-memory fallback is used (single-instance only)
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production — use a long random string (openssl rand -hex 64)
JWT_SECRET=
COOKIE_SECRET=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:8080

# ─── Sectors API ──────────────────────────────────────────────────────────────
SECTORS_API_KEY=
SECTORS_API_BASE_URL=https://api.sectors.app/v2
